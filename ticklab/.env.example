# Copy to .env and fill in (never commit real values).
# TickLab is local-only: price data is imported manually, no network feed.
# Bulk HistData.com folders (default location, overridable per CLI call):
# TICKLAB_PRICE_DIR=../price_data
# Wall-time zone of HistData.com ASCII files (US Eastern):
# TICKLAB_HISTDATA_TZ=America/New_York

# Local TickLab backend port (API + packaged static frontend).
TICKLAB_PORT=4578
# Data dir for ticklab.db (defaults to ./ticklab-data).
# TICKLAB_DATA_DIR=ticklab-data
# Dev only: point the Electrobun window at `next dev` instead of the export.
# TICKLAB_WEB_URL=http://localhost:3000
# NEXT_PUBLIC_API_URL is baked into the web build (must match TICKLAB_PORT).
# Set it in web/.env.local for dev: NEXT_PUBLIC_API_URL=http://127.0.0.1:4578
